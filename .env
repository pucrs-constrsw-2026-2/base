# ConstrSW 2026/2 - Grupo 04 (students)
# Credenciais de DESENVOLVIMENTO/laboratorio - nao sao segredos de producao.

# Console de administracao do Keycloak (http://localhost:8080)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Realm e client usados pela API "oauth" (ja definidos no backup/realm-export
# importado pelo container do Keycloak em backend/oauth/keycloak/realm-export.json)
KEYCLOAK_REALM=constrsw
KEYCLOAK_CLIENT_ID=oauth
KEYCLOAK_CLIENT_SECRET=oauth-client-secret-dev-2026
